HTTP_ADDR=:8080
GRPC_ADDR=:9090

# memory | redis | postgres_redis
STORE=memory

REDIS_ADDR=localhost:6379
DATABASE_URL=postgres://es:es@localhost:5432/es?sslmode=disable

MEMBERSHIP_TTL=14d

# Protects POST /v1/admin/reset
ADMIN_TOKEN=dev-admin-token

OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=100

USS_GRPC_ADDR=localhost:9090
USS_WORKERS=8
USS_EVENTS=1000
