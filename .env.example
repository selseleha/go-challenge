HTTP_ADDR=:8080
GRPC_ADDR=:9090

# memory | redis | postgres_redis
STORE=memory

REDIS_ADDR=localhost:6379
DATABASE_URL=postgres://es:es@localhost:5432/es?sslmode=disable

MEMBERSHIP_TTL=14d

# Protects POST /v1/admin/reset
ADMIN_TOKEN=dev-admin-token

OUTBOX_POLL_INTERVAL=100ms
OUTBOX_BATCH_SIZE=1000
OUTBOX_CLEANUP_INTERVAL=1m
OUTBOX_CLEANUP_RETENTION=15m
OUTBOX_CLEANUP_BATCH=10000
WARM_PAGE_SIZE=50000

USS_GRPC_ADDR=localhost:9090
USS_WORKERS=8
USS_EVENTS=1000
# For multi-million loads bump events/workers and timeout, e.g.:
# USS_EVENTS=3000000 USS_WORKERS=64 USS_TIMEOUT=2h
USS_TIMEOUT=30m
