# Copy to .env and adjust. Loaded automatically by estimator and uss.

# HTTP estimate API listen address
HTTP_ADDR=:8080

# gRPC ingest API listen address (estimator)
GRPC_ADDR=:9090

# Store backend: memory | redis
STORE=memory

# Redis connection (used when STORE=redis)
REDIS_ADDR=localhost:6379

# How long a user stays active in a segment after tagging.
# Accepts day shorthand (14d) or Go duration (336h).
MEMBERSHIP_TTL=14d

# USS simulator (cmd/uss)
# Dial address; if unset, derived from GRPC_ADDR (":9090" -> localhost:9090)
USS_GRPC_ADDR=localhost:9090
USS_WORKERS=8
USS_EVENTS=1000
